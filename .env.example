# Copy this file to .env or set the variables in your shell.
# Never commit real API keys or credential files.
NOTE_BASE_URL=https://api.deepseek.com
NOTE_MODEL=deepseek-flash
NOTE_API_KEY=

REPORT_PROVIDER=deepseek
REPORT_MODEL=deepseek-flash
REPORT_API_KEY=

# Optional local Langfuse tracing. These are Langfuse project credentials, not
# model-provider keys. Leave them empty to keep tracing disabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_PROJECT_URL=
# false stores fingerprints/counts; true stores full prompts and model outputs.
LANGFUSE_CAPTURE_CONTENT=false

# Optional absolute paths on your own machine.
OBSIDIAN_ROOT=
BILIBILI_CREDENTIAL=
V7_GENERATOR_PATH=

# Optional: only required when starting authenticated public mode without `--no-auth`.
# Use a unique 16+ character password.
FUSION_ACCESS_USERNAME=
FUSION_ACCESS_PASSWORD=
# Optional 32+ character secret for passwordless /login#admin=<token> access.
FUSION_ADMIN_TOKEN=
